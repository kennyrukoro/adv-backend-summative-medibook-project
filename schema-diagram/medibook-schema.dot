digraph MediBook {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, nodesep=0.8, ranksep=1.6, pad=0.4,
         label=<<B>MediBook - Database Schema (3NF)</B><BR/>PK = primary key, FK = foreign key, UQ = unique, CK = check, NN = not null>, labelloc=t];
  node  [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10, color="#334155"];

  patients [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1e40af">
    <TR><TD BGCOLOR="#1e40af" COLSPAN="3"><FONT COLOR="white"><B>patients</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe"><B>PK</B></TD><TD ALIGN="LEFT"><B>patient_id</B></TD><TD ALIGN="LEFT">INT UNSIGNED NN AUTO_INCREMENT</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">VARCHAR(100) NN, CK name not blank</TD></TR>
    <TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(255) NN, CK email format</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">VARCHAR(20) NN</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP NN DEFAULT CURRENT_TIMESTAMP</TD></TR>
  </TABLE>>];

  doctors [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#047857">
    <TR><TD BGCOLOR="#047857" COLSPAN="3"><FONT COLOR="white"><B>doctors</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" BGCOLOR="#d1fae5"><B>PK</B></TD><TD ALIGN="LEFT"><B>doctor_id</B></TD><TD ALIGN="LEFT">INT UNSIGNED NN AUTO_INCREMENT</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">VARCHAR(100) NN, CK name not blank</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">specialty</TD><TD ALIGN="LEFT">VARCHAR(80) NN</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">consultation_fee</TD><TD ALIGN="LEFT">DECIMAL(10,2) NN, CK fee &gt;= 0</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">room</TD><TD ALIGN="LEFT">VARCHAR(10) NN</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP NN DEFAULT CURRENT_TIMESTAMP</TD></TR>
  </TABLE>>];

  appointments [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#b45309">
    <TR><TD BGCOLOR="#b45309" COLSPAN="3"><FONT COLOR="white"><B>appointments</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" BGCOLOR="#fef3c7"><B>PK</B></TD><TD ALIGN="LEFT"><B>appointment_id</B></TD><TD ALIGN="LEFT">INT UNSIGNED NN AUTO_INCREMENT</TD></TR>
    <TR><TD ALIGN="LEFT" BGCOLOR="#e0e7ff"><B>FK</B></TD><TD ALIGN="LEFT">patient_id</TD><TD ALIGN="LEFT">INT UNSIGNED NN, -&gt; patients (RESTRICT)</TD></TR>
    <TR><TD ALIGN="LEFT" BGCOLOR="#e0e7ff"><B>FK</B></TD><TD ALIGN="LEFT">doctor_id</TD><TD ALIGN="LEFT">INT UNSIGNED NN, -&gt; doctors (RESTRICT)</TD></TR>
    <TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT"><B>uq_doctor_active_slot</B></TD><TD ALIGN="LEFT">(doctor_id, active_slot) - one patient per doctor slot</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">slot_start</TD><TD ALIGN="LEFT">DATETIME NN, CK :00 or :30, CK 09:00-16:30</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">ENUM(booked, cancelled) NN DEFAULT booked</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">amount_paid</TD><TD ALIGN="LEFT">DECIMAL(10,2) NN, CK &gt;= 0</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">booked_at</TD><TD ALIGN="LEFT">DATETIME NN DEFAULT CURRENT_TIMESTAMP</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">cancelled_at</TD><TD ALIGN="LEFT">DATETIME NULL</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">refund_percent</TD><TD ALIGN="LEFT">TINYINT UNSIGNED NULL, CK IN (0,50,100)</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">refund_amount</TD><TD ALIGN="LEFT">DECIMAL(10,2) NULL, CK 0 .. amount_paid</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">active_slot</TD><TD ALIGN="LEFT">DATETIME GENERATED STORED = slot_start if booked, else NULL</TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" COLSPAN="2"><I>CK: booked rows have no cancellation data; cancelled rows need a full refund record</I></TD></TR>
  </TABLE>>];

  patients -> appointments [dir=both, arrowtail=teeodot, arrowhead=crowodot,
                            taillabel="1", headlabel="0..N", label=" patient books"];
  doctors  -> appointments [dir=both, arrowtail=teeodot, arrowhead=crowodot,
                            taillabel="1", headlabel="0..N", label=" doctor sees"];

  note [shape=note, style=filled, fillcolor="#f1f5f9", fontsize=10, label=<
  <B>Rules enforced outside the table DDL</B><BR ALIGN="LEFT"/>
  - Max 12 appointments per doctor per day: app locks the doctor row (SELECT ... FOR UPDATE)<BR ALIGN="LEFT"/>
    and counts that day inside the same transaction. A CHECK cannot count other rows.<BR ALIGN="LEFT"/>
  - Refund tiers: &gt;48h = 100%, 24-48h = 50%, &lt;24h = 0%. Computed by the server at cancellation.<BR ALIGN="LEFT"/>
  - Cancel + refund record are written in one transaction (all or nothing).<BR ALIGN="LEFT"/>
  Normal forms: every non-key column depends only on its own table's key. Doctor fee, room and specialty<BR ALIGN="LEFT"/>
  live in doctors (no repetition per appointment); amount_paid is a historical snapshot, not derived.<BR ALIGN="LEFT"/>
  >];
  appointments -> note [style=invis];
  {rank=same; patients; doctors;}
}
