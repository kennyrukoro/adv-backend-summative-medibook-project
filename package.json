{
  "name": "medibook-api",
  "version": "1.0.0",
  "description": "MediBook clinic appointment API (Express + MySQL + Redis)",
  "private": true,
  "main": "src/server.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "test": "jest --testPathPattern tests/unit",
    "test:integration": "jest --testPathPattern tests/integration --runInBand --forceExit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "ioredis": "^5.4.1",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
